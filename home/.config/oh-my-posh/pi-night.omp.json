{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Shell }} {{ .PWD }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "lightWhite",
          "template": "›_ {{ .Shell }} {{ .PWD }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}red{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "template": "<b>→</b> "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "cyan",
          "options": {
            "style": "folder"
          },
          "template": " <b>{{ .Path }}</b>"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "blue",
          "options": {
            "branch_icon": "",
            "fetch_status": true
          },
          "template": " <b>git:(<red>{{ .HEAD }}</>)</b>{{ if or .Working.Changed .Staging.Changed }} <yellow>✗</>{{ end }}"
        }
      ],
      "newline": true
    }
  ]
}
